# MLflow : bases par run dans results/, base d'équipe data/mlflow.db (déjà ignorés).
# `mlflow ui` lancé sans argument à la racine y crée mlflow.db (ou mlruns/) et mlartifacts/.
/mlflow.db
/mlruns/
/mlartifacts/

# data/ : seuls les trois sous-dossiers et leur .gitkeep sont suivis.
/data/*
!/data/datasets/
!/data/features/
!/data/models/
/data/*/*
!/data/*/.gitkeep

