# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Données, poids, sorties (jamais dans git)
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.engine
*.tflite
outputs/
multirun/
/results/*
!/results/.gitkeep
lightning_logs/
wandb/
features/

# data/ : seuls les trois sous-dossiers et leur .gitkeep sont suivis.
# Après les règles ci-dessus : la dernière règle qui s'applique l'emporte (sinon
# `features/` ignorerait aussi data/features/).
/data/*
!/data/datasets/
!/data/features/
!/data/models/
/data/*/*
!/data/*/.gitkeep

# Documents
*.pdf

# Notebooks
.ipynb_checkpoints/

# Env / secrets
.env
.env.*
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
